// Modèle de données SGC — CDC §5.2
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  OPERATEUR
}

enum RemiseType {
  AUCUNE
  POURCENTAGE
  MONTANT
}

enum StatutCommande {
  BROUILLON
  VALIDEE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  MOBILE_MONEY
  VIREMENT
}

enum PrioriteRappel {
  FAIBLE
  NORMALE
  URGENTE
}

enum StatutRappel {
  EN_COURS
  TERMINE
}

enum StatutBon {
  BROUILLON
  ENVOYE
  VALIDE
  LIVRE // aller-retour : livré, en attente de paiement
  PAYE // aller-retour : payé après livraison
  CONVERTI
}

model Utilisateur {
  id           String     @id @default(cuid())
  nom          String
  email        String     @unique
  passwordHash String
  role         Role       @default(OPERATEUR)
  commandes    Commande[]
  createdAt    DateTime   @default(now())
}

model Client {
  id           String     @id @default(cuid())
  nom          String
  telephone    String
  email        String?
  adresse      String?
  soldeInitial Decimal    @default(0) @db.Decimal(12, 2) // solde d'ouverture (créance reprise du papier)
  archived     Boolean    @default(false) // F-A04 : suppression logique
  commandes    Commande[]
  paiements    Paiement[]
  rappels      Rappel[]
  bonsCommande BonCommande[]
  createdAt    DateTime      @default(now())

  @@index([nom])
  @@index([telephone])
}

model Rappel {
  id        String         @id @default(cuid())
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  echeance  DateTime // date d'échéance du rappel
  priorite  PrioriteRappel @default(NORMALE)
  statut    StatutRappel   @default(EN_COURS)
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@index([echeance])
  @@index([statut])
}

model Paiement {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  montant     Decimal      @db.Decimal(12, 2)
  mode        ModePaiement @default(ESPECES)
  date        DateTime     @default(now())
  observation String?
  createdAt   DateTime     @default(now())

  @@index([clientId])
  @@index([date])
}

model Commande {
  id             String          @id @default(cuid())
  numero         String          @unique // ex: CMD-2025-000123
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id])
  clientNomLibre String? // client occasionnel (F-B01)
  utilisateurId  String?
  utilisateur    Utilisateur?    @relation(fields: [utilisateurId], references: [id])
  lignes         LigneCommande[]
  remiseType     RemiseType      @default(AUCUNE)
  remiseValeur   Decimal         @default(0) @db.Decimal(12, 2)
  sousTotal      Decimal         @db.Decimal(12, 2)
  montantRemise  Decimal         @db.Decimal(12, 2)
  totalTTC       Decimal         @db.Decimal(12, 2)
  ancienSolde    Decimal         @default(0) @db.Decimal(12, 2) // solde reporté sur la facture
  montantPaye    Decimal         @default(0) @db.Decimal(12, 2) // acompte à la commande
  statut         StatutCommande  @default(VALIDEE)
  date           DateTime        @default(now())

  @@index([clientId])
  @@index([date])
  @@index([statut])
}

model LigneCommande {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  nomProduit   String
  quantite     Decimal  @db.Decimal(12, 3)
  prixUnitaire Decimal  @db.Decimal(12, 2)
  totalLigne   Decimal  @db.Decimal(12, 2)

  @@index([commandeId])
}

// Bon de commande — document de préparation (sans prix) validé avec le client
// avant conversion en commande réelle. Voir module "Bons de commande".
model BonCommande {
  id               String     @id @default(cuid())
  numero           String     @unique // ex: BC-2026-000001
  clientId         String?
  client           Client?    @relation(fields: [clientId], references: [id])
  clientNomLibre   String? // client ponctuel (saisie libre)
  telephone        String? // téléphone de livraison
  adresseLivraison String? // adresse de livraison
  lignes           LigneBon[]
  notes            String? // notes libres
  statut           StatutBon  @default(BROUILLON)
  allerRetour      Boolean    @default(false) // paiement à la livraison (livré puis payé)
  montant          Decimal    @default(0) @db.Decimal(12, 2) // montant de la créance (aller-retour)
  commandeId       String? // commande générée à la conversion (référence libre)
  date             DateTime   @default(now())
  createdAt        DateTime   @default(now())

  @@index([clientId])
  @@index([date])
  @@index([statut])
}

model LigneBon {
  id          String      @id @default(cuid())
  bonId       String
  bon         BonCommande @relation(fields: [bonId], references: [id], onDelete: Cascade)
  designation String
  quantite    Decimal     @db.Decimal(12, 3)
  servi       String? // quantité servie — saisie manuelle libre (pas de calcul auto)
  ordre       Int         @default(0) // ordre d'affichage des lignes

  @@index([bonId])
}
