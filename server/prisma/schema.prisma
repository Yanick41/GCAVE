// Modèle de données SGC — CDC §5.2
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  OPERATEUR
}

enum RemiseType {
  AUCUNE
  POURCENTAGE
  MONTANT
}

enum StatutCommande {
  BROUILLON
  VALIDEE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  MOBILE_MONEY
  VIREMENT
}

enum PrioriteRappel {
  FAIBLE
  NORMALE
  URGENTE
}

enum StatutRappel {
  EN_COURS
  TERMINE
}

enum StatutBon {
  BROUILLON
  ENVOYE
  VALIDE
  LIVRE // aller-retour : livré, en attente de paiement
  PAYE // aller-retour : payé après livraison
  CONVERTI
}

model Utilisateur {
  id           String     @id @default(cuid())
  nom          String
  email        String     @unique
  passwordHash String
  role         Role       @default(OPERATEUR)
  commandes    Commande[]
  createdAt    DateTime   @default(now())
}

model Client {
  id           String     @id @default(cuid())
  nom          String
  telephone    String
  email        String?
  adresse      String?
  soldeInitial Decimal    @default(0) @db.Decimal(12, 2) // solde d'ouverture (créance reprise du papier)
  archived     Boolean    @default(false) // F-A04 : suppression logique
  commandes    Commande[]
  paiements    Paiement[]
  rappels      Rappel[]
  bonsCommande BonCommande[]
  createdAt    DateTime      @default(now())

  @@index([nom])
  @@index([telephone])
}

model Rappel {
  id        String         @id @default(cuid())
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  echeance  DateTime // date d'échéance du rappel
  priorite  PrioriteRappel @default(NORMALE)
  statut    StatutRappel   @default(EN_COURS)
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@index([echeance])
  @@index([statut])
}

model Paiement {
  id       String @id @default(cuid())
  // NULL = encaissement d'une vente comptoir : la facture existe, le client
  // n'a pas de fiche. Sans cela une vente de passage ne pourrait porter aucun
  // règlement et n'apparaîtrait ni dans les paiements, ni dans le rapport.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Commande réglée par ce paiement (une commande peut recevoir plusieurs
  // paiements partiels). NULL = paiement libre sur le solde global du client.
  // SetNull : supprimer une commande ne fait pas disparaître l'encaissement,
  // il redevient un paiement sur le solde global.
  commandeId  String?
  commande    Commande?    @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  montant     Decimal      @db.Decimal(12, 2)
  mode        ModePaiement @default(ESPECES)
  date        DateTime     @default(now())
  observation String?
  createdAt   DateTime     @default(now())

  @@index([clientId])
  @@index([commandeId])
  @@index([date])
}

model Commande {
  id             String          @id @default(cuid())
  numero         String          @unique // ex: CMD-2025-000123
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id])
  clientNomLibre String? // client occasionnel, ou vente comptoir (F-B01)
  // Téléphone d'un client de passage, sans fiche client. Facultatif : une
  // vente comptoir peut n'avoir ni nom ni numéro.
  clientTelephoneLibre String?
  utilisateurId  String?
  utilisateur    Utilisateur?    @relation(fields: [utilisateurId], references: [id])
  lignes         LigneCommande[]
  paiements      Paiement[] // paiements partiels ou total rattachés à la commande
  remiseType     RemiseType      @default(AUCUNE)
  remiseValeur   Decimal         @default(0) @db.Decimal(12, 2)
  sousTotal      Decimal         @db.Decimal(12, 2)
  montantRemise  Decimal         @db.Decimal(12, 2)
  totalTTC       Decimal         @db.Decimal(12, 2)
  ancienSolde    Decimal         @default(0) @db.Decimal(12, 2) // solde reporté sur la facture
  // Montant encaissé sur la commande.
  // • Ancien suivi (utiliseNouveauSuiviPaiement = false) : acompte saisi à la
  //   validation, figé — c'est la seule source du « payé » de la facture.
  // • Nouveau suivi : colonne DÉRIVÉE, resynchronisée par le serveur à chaque
  //   création/suppression de paiement rattaché (= somme des `paiements`).
  montantPaye    Decimal         @default(0) @db.Decimal(12, 2)
  // Drapeau explicite de régime de suivi des paiements, posé à la création.
  // false = commandes antérieures au déploiement du rattachement
  // paiement ↔ commande : comportement historique préservé, jamais basculé
  // automatiquement. true = commandes créées après, suivi dérivé des paiements.
  utiliseNouveauSuiviPaiement Boolean @default(false)
  statut         StatutCommande  @default(VALIDEE)
  date           DateTime        @default(now())

  @@index([clientId])
  @@index([date])
  @@index([statut])
}

model LigneCommande {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  nomProduit   String
  quantite     Decimal  @db.Decimal(12, 3)
  // Texte saisi pour la quantité (« 1/2 »), conservé pour l'AFFICHAGE seul :
  // le calcul s'appuie toujours sur `quantite`. Nul pour les lignes
  // antérieures, qui retombent alors sur le décimal formaté.
  quantiteSaisie String?
  prixUnitaire Decimal  @db.Decimal(12, 2)
  totalLigne   Decimal  @db.Decimal(12, 2)

  @@index([commandeId])
}

// Bon de commande — document de préparation (sans prix) validé avec le client
// avant conversion en commande réelle. Voir module "Bons de commande".
model BonCommande {
  id               String     @id @default(cuid())
  numero           String     @unique // ex: BC-2026-000001
  clientId         String?
  client           Client?    @relation(fields: [clientId], references: [id])
  clientNomLibre   String? // client ponctuel (saisie libre)
  telephone        String? // téléphone de livraison
  adresseLivraison String? // adresse de livraison
  lignes           LigneBon[]
  notes            String? // notes libres
  statut           StatutBon  @default(BROUILLON)
  allerRetour      Boolean    @default(false) // paiement à la livraison (livré puis payé)
  montant          Decimal    @default(0) @db.Decimal(12, 2) // montant de la créance (aller-retour)
  commandeId       String? // commande générée à la conversion (référence libre)
  date             DateTime   @default(now())
  createdAt        DateTime   @default(now())

  @@index([clientId])
  @@index([date])
  @@index([statut])
}

model LigneBon {
  id          String      @id @default(cuid())
  bonId       String
  bon         BonCommande @relation(fields: [bonId], references: [id], onDelete: Cascade)
  designation String
  quantite    Decimal     @db.Decimal(12, 3)
  // Texte saisi pour la quantité (« 1/2 »), conservé pour l'AFFICHAGE seul :
  // le calcul s'appuie toujours sur `quantite`. Nul pour les lignes
  // antérieures, qui retombent alors sur le décimal formaté.
  quantiteSaisie String?
  servi       String? // quantité servie — saisie manuelle libre (pas de calcul auto)
  ordre       Int         @default(0) // ordre d'affichage des lignes

  @@index([bonId])
}
